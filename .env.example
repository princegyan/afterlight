# Works without an AI key: the UI clearly labels rule-based demo extraction.
PORT=4173
HOST=127.0.0.1
DATA_DIR=./data
# Optional server-side OpenAI-compatible chat completions provider.
# Use a model that supports image input to enable synthetic image analysis.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
# Set a token before making the server publicly accessible.
# Judges enter it in the app; include it privately in the Devpost form.
DEMO_ACCESS_TOKEN=
# Optional compatible raster tile provider. Honor attribution and usage terms.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
